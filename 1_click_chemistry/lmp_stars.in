units		lj           # Dimensionless units
atom_style	bond     # Atoms now need to store their topology data,
		                 # hence the atom_style bond.

variable init_size equal "800"
region mybox block 0 ${init_size} 0 ${init_size} 0 ${init_size} 

# You need to pass extra/special/per/atom because you need to be able to
# store special_bonds and you need to pass extra/bond/per/atom becausee
# an atom can have at most 4 bonds (the centre of eye)
create_box 8 mybox bond/types 2 extra/special/per/atom 100 extra/bond/per/atom 4


molecule stara ${molA}
molecule starb ${molB}

# You still need to set per-type masses for some reason...
mass 1 1
mass 2 1
mass 3 1
mass 4 1
mass 5 1 
mass 6 1
mass 7 1
mass 8 1


# create atoms # offset style Nparticles seed region-ID
variable Nstars equal 75

# Syntax is:
# create_atoms <offset> random <number to make> <random seed> <region> mol <mol id> <another random seed>
create_atoms 0 random ${Nstars} 1 mybox mol stara 1337
create_atoms 0  random ${Nstars} 2 mybox mol starb 1338

variable conc equal ${conc_val}


variable   r0 equal "1"	
variable   sigma_coeff equal "1.3"
variable   sigma equal "v_r0 * v_sigma_coeff"
variable   rcut equal "v_sigma * 2.0 ^ (1.0/6.0)"                # Here F = 0 for lj/cut 

variable   v_init equal "v_init_size*v_init_size*v_init_size"
variable   v_final equal "atoms * ((v_sigma)^3)/(v_conc/100)"
variable   boxsize equal "v_v_final^(1.0/3.0)"
variable   scale equal "(v_v_final/v_v_init)^(1.0/3.0)"
variable   compression_runs equal "ceil(100000/(v_conc))"      

variable   n_mon equal "v_Nstars * 2"


print "compression is ${compression_runs}"
print "scale is ${scale}"
print "box size final is ${boxsize}"

# fix print tensor
variable my_pxx equal pxx
variable my_pyy equal pyy
variable my_pzz equal pzz
variable my_pxy equal pxy
variable my_pxz equal pxz
variable my_pyz equal pyz
variable my_press equal press

group   center type 1
group   irr_binding type 2 3 4


pair_style lj/cut 3.0
pair_coeff * * 1.0 ${sigma} ${rcut}           # Purely repulsive interactions



pair_modify shift yes

bond_style      harmonic             # Harmonic bonds
bond_coeff      1 50.0 ${r0}         # Bond coefficients. Spring constant 50.0,
bond_coeff      2 50.0 ${r0}         # Bond coefficients. Spring constant 50.0,

neighbor	0.8 bin                    # Neighbour list settings that prevent
                                     # dangerous builds

velocity all create 2.0 ${seed}      # Initial velocity.
minimize 1e-6 1e-10 10000 100000

reset_timestep 0

fix	step all nve                     # Time integrator


variable sleft equal "cpuremain"         # Est. simulation time remaining (seconds)
variable hleft equal "v_sleft / 3600.0"  # Est. simulation time remaining (hours)

# Custom output to screen, now print hours left and time in
# simulation units in addition to other info
thermo_style custom v_hleft time step pe ke etotal epair emol press
thermo 5000


fix    temp all langevin 0.5 0.5 300 1     # Temperature #change rand seed: arg[4]-> ${seed}, can be passed in the cmd line 
fix    compress all deform 1 x scale ${scale} y scale ${scale} z scale ${scale}	# Slowly compressing the box to reach desired density

run ${compression_runs}

unfix compress
# dump	traj all custom 5000 hydrogel_bond_stars${n_mon}_4_arms_conc${conc}_velocity${seed}.bin id mol type x y z

compute cmd center msd

variable time_now equal time
variable t0  equal ${time_now}
variable t   equal "time - v_t0"
variable dx2 equal c_cmd[4]

# fix print all print 5000 "$t ${dx2}" file msd_${fileoutput}.txt screen no

run 500000

# fix tensor_out all print 10000  "${my_pxx} ${my_pyy} ${my_pzz} ${my_pxy} ${my_pxz} ${my_pyz} ${my_press}" file tensor_${fileoutput}.dat screen no

compute chunks all chunk/atom molecule nchunk once		# define molecules(stars) as chunks 
compute rgyration all gyration/chunk chunks 		      # compute radius of gyration for each chunk(star)
# fix gyr all ave/time 100 1 100 c_rgyration file rgyr_${fileoutput}.dat mode vector		# print the time average of the radius of gyration for each chunk

run 1000000

# unfix gyr
# write_restart eq_${fileoutput}.restart


variable r_bond equal "v_sigma"
fix     newbond all bond/create 1 2 3  ${r_bond} 2 iparam 1 4 jparam  1 4
                                # fix ID group-ID bond/create Nevery itype jtype Rmin bondtype keyword
thermo_style custom v_hleft time step pe ke etotal epair emol press f_newbond[2]

# dump trajC center custom 10000 centerTraj_${fileoutput}.bin id mol type x y z
# dump trajI irr_binding custom 10000 irrEndTraj_${fileoutput}.bin id mol type x y 

# dump trajC_WL center custom 5 centerTraj_WL.bin id mol type x y z
# dump trajI_WL irr_binding custom 5 irrEndTraj_WL.bin id mol type x y z
# dump traj_all_WL all custom 5 all_WL.bin id mol type x y z

#print bond info
variable type4 atom "type == 4"
group newlinks dynamic all var type4 every 1000
compute bonds newlinks property/local batom1 batom2 btype
# dump	crosslinks all local 5000 bondinfo_${fileoutput}.dump c_bonds[1] c_bonds[2] c_bonds[3]

# count how many new crosslinks are created

variable time_nowc equal time
variable t0c  equal ${time_nowc}
variable tc  equal "time - v_t0c"
variable countbond4 equal f_newbond[2]
variable step0 equal step

fix print2 all print 500000 "${tc} ${countbond4}" file crosslink_${fileoutput}.txt screen no

run 10000000

# Finally store the current snapshot to apply percolation checks and stuff.
write_restart final_snapshot_${fileoutput}.restart
write_data datatarsnetwork_${fileoutput}.polymer
