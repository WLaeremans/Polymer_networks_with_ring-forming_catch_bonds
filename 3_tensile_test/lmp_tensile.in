

# Define units and settings (use same as original simulation)
units           lj             
atom_style      bond           


# Read the restart file
read_restart final_snapshot_after_equilibration_${num}.restart


# Define the simulation settings
thermo          50                 # Print thermodynamic info every 50 steps
timestep        0.0005             # Define timestep size

variable   r0 equal "1"	
variable   sigma_coeff equal "1.3"
variable   sigma equal "v_r0 * v_sigma_coeff"
variable   rcut equal "v_sigma * 2.0 ^ (1.0/6.0)"  # Here F = 0 for lj/cut 


##### Interactions

pair_style lj/cut 3.0
pair_coeff * * 1.0 ${sigma} ${rcut}           # Purely repulsive interactions

pair_modify shift yes

special_bonds lj 1.0 1.0 1.0

bond_style   harmonic
bond_coeff   *  50 1.0


minimize 1e-6 1e-10 10000 100000




# #### Phase 1: Apply target stress without reversible ring-opening reactions ####

fix             1 all nve
fix             2 all langevin 0.5 0.5 1.0 ${num}

run 100000

# Here target stress is 0.001
fix defwl2 all deform/pressure 1 x pressure -0.001 0.1 y volume z volume max/rate 0.1


group centersAndEnds type 1 8
dump dump_selected centersAndEnds custom 5000000 output/positions_types123${num}.txt id x y z
dump_modify dump_selected sort id

variable stress equal pxx  # stress in x
variable Lx equal lx
variable Ly equal ly
variable Lz equal lz
variable volume_L equal lx*ly*lz  # Lx * Ly

fix out all print 5000000 "${stress},${Lx},${Ly},${Lz},${volume_L}" file stress_area${num}.csv screen no



# Deformation run
 run             100000000

# ************* 

unfix 1
unfix 2

# reset_timestep 0

# group centersAndEnds type 1 8


# Define output and visualization
# dump            traj_all_WL all custom 500000 short_run.${num}.movie id mol type x y z

compute bonds all property/local batom1 batom2 btype
# dump	crosslinks all local 20000 bondinfo.${num}.dump c_bonds[1] c_bonds[2] c_bonds[3]
# dump_modify     dump_all sort id # Sort atoms by ID in output

# ##### Phase 2: Turn on reversible ring-opening reactions ####

# Molecule templates for reactions
variable r_bond equal "v_sigma"
molecule mol_on1 rxn_pre_on.data_template
molecule mol_on2 rxn_post_on.data_template
molecule mol_off1 rxn_pre_off.data_template
molecule mol_off2 rxn_post_off.data_template


fix rxns all bond/react stabilization yes statted_grp 0.005 &
  react rxn1_stp1 all 1 0.0 ${r_bond} mol_on1 mol_on2 rxn_on.map stabilize_steps 200 prob 0.001 ${num} &
     react rxn_checkon all 1 0.0 ${r_bond} mol_on1 mol_on1 rxn_on.map stabilize_steps 200 prob 0.001 ${num} &	
  react rxn2_stp1 all 1 0.0 ${r_bond} mol_off1 mol_off2 rxn_off.map stabilize_steps 200 prob 0.001 ${num} &
     react rxn_checkoff all 1 0.0 ${r_bond} mol_off1 mol_off1 rxn_off.map stabilize_steps 200 prob 0.001 ${num} &		
  react rxn2_stp2 all 1 0.0 ${rcut} mol_off2 mol_off1 rxn_off.map stabilize_steps 200 



fix 3 statted_grp_REACT nvt temp 0.5 0.5 $(100.0*dt)

# Variables for printing
variable r equal f_rxns[1]		# breaking on chain
variable r3 equal f_rxns[3]			# breaking off chain
variable r4 equal f_rxns[5]			# bond formation
variable t equal step

# Print bond information
fix extra all print 5000000 '${r} ${r3} ${r4} ${t}' file output/bond_info.reacter${num}.txt
# dump dump_selected centersAndEnds custom 20000 output/positions_types123${num}.txt id x y z
# dump_modify dump_selected sort id



# run 200000000
run 100000000
#write_restart final_snapshot_after_equilibration_${num}.restart
write_data data_${num}.polymer
